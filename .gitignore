# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts (keep counter bindings + keys for Vercel UI build)
contracts/managed/hello-world/
contracts/managed/compiler/
contracts/managed/contract/
contracts/managed/keys/
contracts/managed/zkir/

# Root managed/ is a post-compile mirror of contracts/managed/counter
# (created by scripts/ensure-managed-root.mjs). Keep the folder via .gitkeep.
/managed/**
!/managed/.gitkeep

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

.vercel
